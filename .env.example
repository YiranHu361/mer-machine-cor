# Local-only application. Copy to .env and enter values only in that ignored file.
# Required only for the corresponding explicitly selected mode; never use mainnet.
FABYN_MODE=
# simulation or hardware; unset means labeled simulation.
FABYN_STORE=
# spacetimedb or sqlite-development. No silent fallback after store connection failure.
FABYN_SPACETIME_URI=
# WebSocket endpoint for the configured SpacetimeDB.
FABYN_SPACETIME_DATABASE=
# Published database name.
FABYN_SPACETIME_TOKEN=
# Publishing/backend identity token; never expose to browsers.
FABYN_PAYMENT_MODE=
# mock or testnet. Unset means mock. Production payments unsupported.
FABYN_TREASURY_ADDRESS=
# Platform-controlled Base Sepolia test treasury wallet address.
FABYN_TREASURY_PRIVATE_KEY=
# Test treasury signer; needed only for owner release and requester refund.
FABYN_BASE_SEPOLIA_RPC=
# Base Sepolia RPC endpoint; chain 84532 is enforced.
FABYN_X402_FACILITATOR=
# Optional; defaults to https://x402.org/facilitator (Base Sepolia, no API key).
FABYN_PUBLIC_ORIGIN=
# The app's public address, e.g. https://fabyn.vercel.app (npm run vercel:link). Browsers
# there may act like the local interface; it also binds x402 payments and agent preview links.
FABYN_OWNER_CODE=
# Optional owner access code. Empty or unset: the maker side opens without a code.
FABYN_NODE_KEY=
# Shared node Bearer key; otherwise private local credentials.
FABYN_TOKEN_SECRET=
# Shared dispatch-token HMAC key; otherwise private local credentials.
FABYN_NODE_URL=
# Team-owned node base URL; default loopback node :8788.
FABYN_MACHINES_FILE=
# Private JSON device/adapter config; see node README. No device auto-discovery.
FABYN_CATALOG_FILE=
# Reviewed prepared 3D catalog JSON with 3MF and preview file paths.
ANTHROPIC_API_KEY=
# Claude development key for live image intake and design generation.
FABYN_CLAUDE_MODEL=
# Configured supported Claude model; see integrations docs for verified default.
ASI1_API_KEY=
# ASI:One development key; not a substitute for actual discovery acceptance.
FABYN_AGENT_SEED=
# Agentverse bridge identity seed, kept private.
FABYN_AGENT_ALLOWED_SENDERS=
# Explicit comma-separated sender allowlist for agent invocation.
FABYN_API_ORIGIN=
# Authorized backend origin used by the Fetch bridge.
FABYN_AGENT_SESSION_COOKIE=
# Dedicated requester cookie, never an owner cookie; used only in private bridge configuration.
FABYN_AGENT_PORT=
# Optional local Agentverse adapter port.
ASI1_MODEL=
# Optional ASI model identifier supported by the configured account.
FABYN_BAMBU_ACCESS_CODE=
# Team A1 mini LAN development access code referenced by private machine config.
FABYN_RUN_LIVE_PAYMENTS=
# Explicit finite acceptance opt-in; see integration runbook.
FABYN_TEST_PAYER_PRIVATE_KEY=
# Disposable testnet payer for the CLI demo/acceptance harness, never sent to browsers.
# One-cent collection-only demo: see docs/x402-demo.md. Browser checkout uses its own wallet.
FABYN_OWNER_WALLET=
# Public test recipient for standalone live harness. App owner sets its payout address in owner settings.
FABYN_RUN_LIVE_CLAUDE=
# Explicit opt-in for finite live Claude acceptance.
FABYN_SPACETIME_CONFIG=
# Optional private JSON path for isolated Spacetime integration test credentials.

FABYN_PHOMEMO_NODE_URL=
# Optional configured team Phomemo node override (for example a tested Pi).
FABYN_INSTAX_NODE_URL=
# Optional configured team Instax node override.
FABYN_BAMBU_NODE_URL=
# Optional configured team Bambu node override.
FABYN_CLAUDE_ARTIFACT_PATH=
# Private approved artwork path for the finite live Claude suite.
FABYN_ALLOWED_MODES=
# Comma-separated execution modes orders may use: hardware, simulation or both. Use hardware so orders only go to real machines (npm run mvp defaults to it). Unset means FABYN_MODE only.
FABYN_DESIGN_PROVIDER=
# openai, nano-banana, claude, fixture or none for design drafts. Unset means openai when OPENAI_API_KEY is set, else nano-banana when GEMINI_API_KEY is set, else claude when ANTHROPIC_API_KEY is set, otherwise none.
OPENAI_API_KEY=
# OpenAI key for picture drafts (Image API). Needs billing; OpenAI may ask you to verify your organization first.
FABYN_OPENAI_IMAGE_MODEL=
# Optional; defaults to gpt-image-2.5-flare.
GEMINI_API_KEY=
# Google Gemini key for Nano Banana picture drafts (about $0.034 per picture, three per round). Get one in Google AI Studio.
FABYN_NANO_BANANA_MODEL=
# Optional; defaults to gemini-nano-banana-2.1.
CONTEXT_DEV_API_KEY=
# context.dev key used only when building machine profiles at onboarding, never during an order.
FABYN_PRODUCER_HUB_URL=
# The producer side's hub (producer-side/hub). The owner switches a machine to it in the workshop; its jobs then print there.

CONVEX_DEPLOY_KEY=
# Whole deploy key from the Convex dashboard (Settings -> Deploy keys), starting with dev: or prod:. Used by npm run convex:push.
CONVEX_URL=
# Optional. The Convex deployment URL; otherwise derived from the deploy key. Both hubs publish here and the web live views read it.
FABYN_PUBLISH_SECRET=
# Any long random string. Shared by both hubs and stored in the Convex deployment so only they can write.
FABYN_AUTO_PREPARE_PRINTS=
# 1 records handling of self-ejected paper prints after machine completion and frees the printer. npm run mvp sets 1.
