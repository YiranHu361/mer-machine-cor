# Required bearer key (at least 16 random characters), generated locally.
FABRARY_NODE_KEY=
# HMAC key shared only with backend; defaults to FABRARY_NODE_KEY.
FABRARY_TOKEN_SECRET=
# Node stays on loopback.
FABRARY_NODE_HOST=127.0.0.1
FABRARY_NODE_PORT=8788
FABRARY_NODE_URL=http://127.0.0.1:8788
FABRARY_ASSET_ORIGIN=http://127.0.0.1:4318/assets
FABRARY_NODE_DATA=.data/node
# Omit for three explicitly labeled simulated machines.
# For hardware, copy machines.example.json into .data/machines.json and fill it locally.
FABRARY_MACHINES_FILE=
# Required only by the explicitly configured Bambu printer; never commit the code.
FABRARY_BAMBU_ACCESS_CODE=
