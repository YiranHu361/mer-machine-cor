# Vercel project (repository root). Copy these into the project's environment settings.
CONVEX_URL=https://YOUR-DEPLOYMENT.convex.cloud
FABYN_PUBLISH_SECRET=
FABYN_PUBLIC_ORIGIN=https://YOUR-PROJECT.vercel.app
FABYN_OWNER_CODE=
FABYN_TOKEN_SECRET=
# Random secret of at least 32 characters; share only this one with producer-side/.env.
FABYN_PRODUCER_KEY=
FABYN_MODE=hardware
FABYN_ALLOWED_MODES=hardware
FABYN_PAYMENT_MODE=mock
FABYN_AUTO_PREPARE_PRINTS=1
# Both sticker and photo artwork use OpenAI. All keys stay in Vercel.
FABYN_DESIGN_PROVIDER=openai
OPENAI_API_KEY=
# Optional: Claude interprets requests; it does not generate sticker artwork.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
